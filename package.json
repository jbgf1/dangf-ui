{
  "name": "dangf-ui",
  "version": "0.1.0",
  "description": "Themeable React components for calm, accessible product interfaces.",
  "license": "MIT",
  "author": "jbgf1",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ORIGIN.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns.js",
      "require": "./dist/patterns.cjs"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.cjs"
    },
    "./patterns/marketing": {
      "types": "./dist/patterns/marketing/index.d.ts",
      "import": "./dist/marketing.js",
      "require": "./dist/marketing.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./themes/warm.css": "./dist/themes/warm.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist storybook-static",
    "clean:all": "rimraf dist storybook-static .artifacts fixtures/**/node_modules fixtures/**/.next fixtures/**/dist",
    "build:js": "vite build",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify && node ./scripts/copy-theme.mjs",
    "build": "pnpm clean && pnpm build:js && pnpm build:css",
    "dev": "storybook dev -p 6006",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project ssr",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:pack": "node ./scripts/pack-smoke.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build-storybook && pnpm test:pack"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slider": "^1.3.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.39.0",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^6.0.1",
    "storybook": "^10.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbgf1/dangf-ui.git"
  },
  "bugs": {
    "url": "https://github.com/jbgf1/dangf-ui/issues"
  },
  "homepage": "https://jbgf1.github.io/dangf-ui/"
}
